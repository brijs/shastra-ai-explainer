"t": "devadattaḥ",
"en": "Devadatta",
"role": "kartṛ",
"gram": "nominative singular masculine",
"note": "He is the independent doer: nobody else is acting through him."
},
{
"d": "गृहे",
"t": "gṛhe",
"en": "in the house",
"role": "adhikaraṇa",
"gram": "locative singular neuter",
"note": "The house is the support or setting of the cooking."
},
{
"d": "स्थाल्या",
"t": "sthālyā",
"en": "with a pot",
"role": "karaṇa",
"gram": "instrumental singular feminine",
"note": "The pot is the most effective means: without it the cooking does not happen."
},
{
"d": "ओदनम्",
"t": "odanam",
"en": "rice",
"role": "karman",
"gram": "accusative singular masculine",
"note": "Rice is what the cook most wishes to bring about: it is changed by the action."
},
{
"d": "पचति",
"t": "pacati",
"en": "cooks",
"role": "verb",
"gram": "√pac, present, 3rd person singular",
"note": "The verb ending -ti already tells us: one agent, third person."
}
]
},
{
