{
"rules": {
"1.1.5": {
"dev": "क्ङिति च",
"iast": "kṅiti ca",
"plain": "No guṇa or vṛddhi vowel-strengthening happens before a suffix that has a k or ṅ tag (even after the tag is deleted)."
},
"1.3.2": {
"dev": "उपदेशेऽजनुनासिक इत्",
"iast": "upadeśe 'j-anunāsika it",
"plain": "A nasalised vowel in the original text of a root or suffix is a tag."
},
"1.3.3": {
"dev": "हलन्त्यम्",
"iast": "halantyam",
"plain": "A final consonant of a root or suffix is a tag."
},
"1.3.4": {
"dev": "न विभक्तौ तुस्माः",
"iast": "na vibhaktau tusmāḥ",
"plain": "But the final t-class consonants, s and m of a case ending (vibhakti) are NOT tags. That is why jas, am and bhyām keep their last letter."
},
"1.3.5": {
"dev": "आदिर्ञिटुडवः",
"iast": "ādir ñiṭuḍavaḥ",
"plain": "An initial ñi, ṭu or ḍu of a root is a tag. (ḍukṛñ → kṛ.)"
},
"1.3.6": {
"dev": "षः प्रत्ययस्य",
"iast": "ṣaḥ pratyayasya",
"plain": "An initial ṣ of a suffix is a tag."
},
"1.3.7": {
"dev": "चुटू",
"iast": "cuṭū",
"plain": "An initial c-class or ṭ-class consonant of a suffix is a tag. (ṇvul loses ṇ; jas loses j.)"
},
"1.3.8": {
"dev": "लशक्वतद्धिते",
"iast": "laśakv-ataddhite",
"plain": "An initial l, ś or k-class consonant of a suffix, other than a taddhita suffix, is a tag. (lyuṭ loses l; ktvā loses k; ṅe loses ṅ.)"
},
"1.3.9": {
"dev": "तस्य लोपः",
"iast": "tasya lopaḥ",
"plain": "A tag is deleted."
},
"1.4.24": {
"dev": "ध्रुवमपायेऽपादानम्",
"iast": "dhruvam apāye 'pādānam",
"plain": "The fixed point from which separation occurs is the apādāna (source)."
},
"1.4.32": {
"dev": "कर्मणा यमभिप्रैति स सम्प्रदानम्",
"iast": "karmaṇā yam abhipraiti sa sampradānam",
"plain": "The one whom the agent intends to reach through the object is the sampradāna (recipient)."
},
"1.4.42": {
"dev": "साधकतमं करणम्",
"iast": "sādhakatamaṁ karaṇam",
"plain": "The most effective means is the karaṇa (instrument)."
},
"1.4.45": {
"dev": "आधारोऽधिकरणम्",
"iast": "ādhāro 'dhikaraṇam",
"plain": "The support or substrate is the adhikaraṇa (locus)."
},
"1.4.49": {
"dev": "कर्तुरीप्सिततमं कर्म",
"iast": "kartur īpsitatamaṁ karma",
"plain": "What the agent most wishes to reach is the karman (object)."
},
"1.4.54": {
"dev": "स्वतन्त्रः कर्ता",
"iast": "svatantraḥ kartā",
"plain": "The independent one is the kartṛ (agent)."
},
"3.1.133": {
"dev": "ण्वुल्तृचौ",
"iast": "ṇvul-tṛcau",
"plain": "The suffixes ṇvul and tṛc form agent nouns from a root: kṛ → kāraka, kartṛ."
},
"3.3.117": {
"dev": "करणाधिकरणयोश्च",
"iast": "karaṇādhikaraṇayoś ca",
"plain": "The suffix lyuṭ forms nouns meaning the instrument or the locus of an action: kṛ → karaṇa."
},
"7.1.1": {
"dev": "युवोरनाकौ",
"iast": "yuvor anākau",
"plain": "The suffix pieces yu and vu are replaced by ana and aka."
},
"7.1.24": {
"dev": "अतोऽम्",
"iast": "ato 'm",
"plain": "After an a-ending neuter stem, the nominative and accusative singular ending is -am."
},
"7.2.115": {
"dev": "अचो ञ्णिति",
"iast": "aco ñṇiti",
"plain": "Before a suffix with a ñ or ṇ tag, the final vowel of the root grows to vṛddhi (ṛ → ār)."
},
"7.3.84": {
"dev": "सार्वधातुकार्धधातुकयोः",
"iast": "sārvadhātuka-ārdhadhātukayoḥ",
"plain": "Before most verbal and verb-derived suffixes, the root vowel strengthens to guṇa (ṛ → ar)."
},
"8.2.66": {
"dev": "ससजुषोः रुः",
"iast": "sasajuṣoḥ ruḥ",
"plain": "A word-final s becomes r (and then, at the end of a sentence, a visarga)."
},
"8.3.15": {
"dev": "खरवसानयोर्विसर्जनीयः",
"iast": "kharavasānayor visarjanīyaḥ",
"plain": "At the end of a word, r becomes a visarga (ḥ)."
},
"8.4.1": {
"dev": "रषाभ्यां नो णः समानपदे",
"iast": "raṣābhyāṁ no ṇaḥ samānapade",
"plain": "In the same word, n becomes the retroflex ṇ after r or ṣ, if only vowels and certain consonants (h, y, v, r, k-class, p-class) lie between."
}
},
"karakas": [
{
"id": "kartṛ",
"dev": "कर्तृ",
"en": "Agent",
"vib": "usually 1st (prathamā, nominative)",
"ref": "1.4.54",
"meaning": "The independent one is the agent.",
"fn": "The main instigator or doer of the action.",
"ex": {
"dev": "देवदत्तः पचति।",
"iast": "devadattaḥ pacati",
"en": "Devadatta cooks."
}
},
{
"id": "karman",
"dev": "कर्म",
"en": "Object",
"vib": "usually 2nd (dvitīyā, accusative)",
"ref": "1.4.49",
"meaning": "What the agent desires most to achieve is the object.",
"fn": "The entity most directly affected by the action.",
"ex": {
"dev": "देवदत्तः ओदनं पचति।",
"iast": "devadattaḥ odanaṁ pacati",
"en": "Devadatta cooks rice."
}
},
{
"id": "karaṇa",
"dev": "करण",
"en": "Instrument",
"vib": "usually 3rd (tṛtīyā, instrumental)",
"ref": "1.4.42",
"meaning": "The most effective means or helper is the instrument.",
"fn": "The tool or immediate instrument used to accomplish the action.",
"ex": {
"dev": "देवदत्तः स्थाल्या ओदनं पचति।",
"iast": "devadattaḥ sthālyā odanaṁ pacati",
"en": "Devadatta cooks rice with a pot."
}
},
{
"id": "sampradāna",
"dev": "सम्प्रदान",
"en": "Recipient",
"vib": "usually 4th (caturthī, dative)",
"ref": "1.4.32",
"meaning": "Whom one intends to reach through the object given is the recipient.",
"fn": "The person or thing for whom the action is performed (usually giving).",
"ex": {
"dev": "विप्राय गां ददाति।",
"iast": "viprāya gāṁ dadāti",
"en": "He gives a cow to the scholar."
}
},
{
"id": "apādāna",
"dev": "अपादान",
"en": "Source",
"vib": "usually 5th (pañcamī, ablative)",
"ref": "1.4.24",
"meaning": "The fixed point during separation is the source.",
"fn": "The starting point from which separation, movement or fear occurs.",
"ex": {
"dev": "वृक्षात् पत्रं पतति।",
"iast": "vṛkṣāt patraṁ patati",
"en": "A leaf falls from the tree."
}
},
{
"id": "adhikaraṇa",
"dev": "अधिकरण",
"en": "Locus",
"vib": "usually 7th (saptamī, locative)",
"ref": "1.4.45",
"meaning": "The substratum or support of the action is the locus.",
"fn": "The location, time or abstract domain where the action takes place.",
"ex": {
"dev": "देवदत्तः गृहे ओदनं पचति।",
"iast": "devadattaḥ gṛhe odanaṁ pacati",
"en": "Devadatta cooks rice in the house."
}
}
],
"sentences": [
{
