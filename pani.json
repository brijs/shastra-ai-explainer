"d": "वृक्षात्",
"t": "vṛkṣāt",
"en": "from the tree",
"role": "apādāna",
"gram": "ablative singular masculine",
"note": "The tree is the fixed point the leaf separates from."
},
{
"d": "पत्रम्",
"t": "patram",
"en": "a leaf",
"role": "kartṛ",
"gram": "nominative singular neuter",
"note": "The leaf is the one that falls, so it is the agent (kartṛ), not an object: roles come from the action, not from grammar labels."
},
