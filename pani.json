"role": "sampradāna",
"gram": "dative singular masculine",
"note": "The scholar is whom the giver intends the cow to reach."
},
{
"d": "गाम्",
"t": "gām",
"en": "a cow",
"role": "karman",
"gram": "accusative singular feminine",
"note": "The cow is the thing given: the object."
},
{
"d": "ददाति",
"t": "dadāti",
"en": "gives",
"role": "verb",
"gram": "√dā, present, 3rd person singular",
"note": "The ending -ti supplies “he”."
}
]
},
{
